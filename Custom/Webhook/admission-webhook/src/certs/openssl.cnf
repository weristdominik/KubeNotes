[ req ]
default_bits       = 2048
prompt             = no
default_md         = sha256
req_extensions     = req_ext
distinguished_name = dn

[ dn ]
CN = pod-validator.default.svc.cluster.local

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = pod-validator
DNS.2 = pod-validator.default
DNS.3 = pod-validator.default.svc
DNS.4 = pod-validator.default.svc.cluster.local
